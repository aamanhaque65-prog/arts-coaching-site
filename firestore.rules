rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'OWNER_ADMIN_UID_FROM_FIREBASE',
          'FATHER_ADMIN_UID_FROM_FIREBASE',
          'UNCLE_ADMIN_UID_FROM_FIREBASE'
        ];
    }

    function adminRole(uid) {
      return uid == 'OWNER_ADMIN_UID_FROM_FIREBASE' ? 'Owner'
        : uid == 'FATHER_ADMIN_UID_FROM_FIREBASE' ? 'Father'
        : uid == 'UNCLE_ADMIN_UID_FROM_FIREBASE' ? 'Paternal uncle'
        : '';
    }

    match /students/{studentId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'name', 'studentClass', 'phone', 'address',
          'monthlyFee', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'studentClass', 'phone', 'address',
          'monthlyFee', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.studentClass is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.monthlyFee is int
        && request.resource.data.monthlyFee >= 0
        && request.resource.data.monthlyFee <= 1000000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /monthlyFees/{feeId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'studentId', 'studentName', 'studentClass',
          'month', 'amountPaise', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'studentClass',
          'month', 'amountPaise', 'createdAt'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.studentClass is string
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.amountPaise is int
        && request.resource.data.amountPaise >= 0
        && request.resource.data.amountPaise <= 100000000
        && request.resource.data.createdAt == request.time
        && feeId == request.resource.data.studentId + '_' + request.resource.data.month
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'studentId', 'studentName', 'studentClass', 'month',
          'amount', 'method', 'status', 'receiptNo', 'createdAt', 'paidAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'studentClass', 'month',
          'amount', 'method', 'status', 'receiptNo', 'createdAt', 'paidAt'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.studentClass is string
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.method == 'Cash'
        && request.resource.data.status == 'paid'
        && request.resource.data.receiptNo == paymentId
        && request.resource.data.createdAt == request.time
        && request.resource.data.paidAt == request.time
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && exists(/databases/$(database)/documents/monthlyFees/$(request.resource.data.studentId + '_' + request.resource.data.month));
      allow update, delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'actorUid', 'actorName', 'action', 'targetId',
          'targetType', 'summary', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'action', 'targetId',
          'targetType', 'summary', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName == adminRole(request.auth.uid)
        && request.resource.data.action in [
          'student_created', 'monthly_fee_created', 'cash_payment_recorded'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ['student', 'monthly_fee', 'payment']
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
