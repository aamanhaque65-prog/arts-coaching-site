rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'YOUR_ADMIN_UID';
    }

    match /students/{studentId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'name', 'studentClass', 'phone', 'address',
          'monthlyFee', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'studentClass', 'phone', 'address',
          'monthlyFee', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.studentClass is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.monthlyFee is int
        && request.resource.data.monthlyFee >= 0
        && request.resource.data.monthlyFee <= 1000000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'studentId', 'studentName', 'month', 'amount',
          'receiptNo', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'month', 'amount',
          'receiptNo', 'createdAt'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.receiptNo == paymentId
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
